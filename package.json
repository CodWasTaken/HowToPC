{
  "name": "howtopc",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @howtopc/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
